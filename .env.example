# Postgres with PostGIS (Supabase pooler URL, or local)
DATABASE_URL=
# Random string for signing session cookies
SESSION_SECRET=
# xAI key (console.x.ai), starts with xai-. Used for the voice agent and query parsing.
XAI_API_KEY=
# virtual (in-browser venue phone at /phone, live Grok voice) | scripted (no voice model) | twilio
CALL_MODE=virtual
# Public base URL (needed for Twilio webhooks; HTTPS needed for /phone on a real phone)
PUBLIC_URL=http://localhost:3000
# Optional: lock /phone to ?key=...
PHONE_KEY=
# Only for CALL_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
